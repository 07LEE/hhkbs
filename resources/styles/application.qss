QWidget {
    background: #f4f5f7;
    color: #20242a;
    font-family: "Inter", "Noto Sans", sans-serif;
    font-size: 14px;
}

QLabel#title {
    font-size: 28px;
    font-weight: 700;
}

QLabel#subtitle,
QLabel#placeholderBody {
    color: #69717d;
}

QLabel#connectionStatus {
    background: #e8eaed;
    border-radius: 14px;
    color: #555d68;
    font-weight: 600;
    min-height: 28px;
    padding: 0 14px;
}

QLabel#connectionStatus[state="connected"] {
    background: #dff4e7;
    color: #176438;
}

QLabel#connectionStatus[state="error"] {
    background: #fbe5e5;
    color: #9b3030;
}

QTabBar::tab {
    background: transparent;
    border: 0;
    color: #737b86;
    min-width: 72px;
    padding: 10px 14px;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #2b6de5;
    color: #20242a;
    font-weight: 600;
}

QFrame#workspace {
    background: #ffffff;
    border: 1px solid #dfe2e7;
    border-radius: 14px;
}

QLabel#placeholderTitle {
    background: transparent;
    font-size: 20px;
    font-weight: 650;
}

QLabel#placeholderBody {
    background: transparent;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #cfd4db;
    border-radius: 7px;
    min-height: 36px;
    padding: 0 14px;
}

QPushButton:hover {
    border-color: #99a2af;
}

QPushButton#primaryButton {
    background: #2b6de5;
    border-color: #2b6de5;
    color: #ffffff;
}

QPushButton:disabled {
    background: #eceef1;
    border-color: #dfe2e7;
    color: #9da4ae;
}
